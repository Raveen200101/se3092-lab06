<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        style="@style/ScreenContent"
        android:focusableInTouchMode="true">

        <TextView
            style="@style/ScreenTitle"
            android:text="@string/dashboard" />

        <LinearLayout
            style="@style/SurfaceCard"
            android:layout_marginTop="24dp"
            android:background="@drawable/balance_card">

            <TextView
                style="@style/BodyText"
                android:text="@string/available_balance"
                android:textColor="@color/on_accent" />

            <TextView
                android:id="@+id/tvBalance"
                style="@style/ScreenTitle"
                android:layout_marginTop="6dp"
                android:text="@string/demo_balance"
                android:textColor="@color/on_accent" />
        </LinearLayout>

        <Button
            android:id="@+id/btnGoToTransfer"
            style="@style/PrimaryAction"
            android:text="@string/transfer_funds" />

        <Button
            android:id="@+id/btnGoToHistory"
            style="@style/SecondaryAction"
            android:text="@string/transfer_history" />
    </LinearLayout>
</ScrollView>
